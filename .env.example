# OmniApex — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env for local development.
# In production (Netlify), add these as environment variables
# via: Netlify Dashboard → Site Settings → Environment Variables
#
# NEVER commit a real .env file to Git.
# This .env.example file is safe to commit — it contains no real values.

# ── Email Provider ─────────────────────────────────────────────────
# Options: "resend" or "sendgrid"
# Resend (https://resend.com) is recommended — simple free tier, great DX
EMAIL_PROVIDER=resend

# ── Email API Key ──────────────────────────────────────────────────
# Get this from your email provider's dashboard
# Resend: https://resend.com/api-keys
# SendGrid: https://app.sendgrid.com/settings/api_keys
EMAIL_API_KEY=your_api_key_here

# ── Destination Email ──────────────────────────────────────────────
# Where form submissions are delivered — your Gmail address
EMAIL_TO=your_gmail@gmail.com

# ── Sender Email ───────────────────────────────────────────────────
# Must be a verified domain in your email provider account
# Resend: Add and verify your domain at https://resend.com/domains
# SendGrid: Add and verify at https://app.sendgrid.com/settings/sender_auth
EMAIL_FROM=noreply@your-domain.com
